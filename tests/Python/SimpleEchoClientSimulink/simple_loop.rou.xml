<?xml version="1.0" encoding="UTF-8"?>

<!-- Routes for simple loop scenario -->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Vehicle type -->
    <vType id="car" vClass="passenger" length="5.0" minGap="2.5" maxSpeed="20.0" accel="2.6" decel="4.5" sigma="0.5"/>

    <!-- Loop route: bottom -> right -> top -> left -> repeat -->
    <route id="loop" edges="bottom right top left" repeat="100"/>

    <!-- Ego vehicle (red) controlled by Python client and Simulink -->
    <vehicle id="ego" type="car" route="loop" depart="0" color="1,0,0"/>

    <!-- Additional traffic vehicles (green) -->
    <vehicle id="traffic_0" type="car" route="loop" depart="2" color="0,1,0"/>
    <vehicle id="traffic_1" type="car" route="loop" depart="6" color="0,1,0"/>
    <vehicle id="traffic_2" type="car" route="loop" depart="8" color="0,1,0"/>
    <vehicle id="traffic_3" type="car" route="loop" depart="10" color="0,1,0"/>
    <vehicle id="traffic_4" type="car" route="loop" depart="12" color="0,1,0"/>
    <vehicle id="traffic_5" type="car" route="loop" depart="14" color="0,1,0"/>
    <vehicle id="traffic_6" type="car" route="loop" depart="16" color="0,1,0"/>
    <vehicle id="traffic_7" type="car" route="loop" depart="18" color="0,1,0"/>
    <vehicle id="traffic_8" type="car" route="loop" depart="20" color="0,1,0"/>
    <vehicle id="traffic_9" type="car" route="loop" depart="22" color="0,1,0"/>

</routes>
