<?xml version="1.0" encoding="UTF-8"?>

<!-- SUMO configuration for the multi-vehicle subscription repro (issue #176). -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="simple_loop.net.xml"/>
        <route-files value="simple_loop_traffic.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>

</configuration>
