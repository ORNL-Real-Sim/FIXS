-- ******** Model variables ***************************************************

group "Model Root"
	group "Sine Wave" -- block-group
	{
	 block: "Sin"
	}
		p_0_tmp_real_T_0[0]
		{
		 type:    flt(64,IEEE)*
		 alias:   "Out1"
		 flags:   OUTPUT|READONLY
		}
		p_1_tmp_real_T_0[0]
