<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="MLK_final_elevation_20250930.net.xml"/>
        <route-files value="routes_8_9AM_v2.rou.xml"/>
    </input>
    <time>
        <begin value="28800"/>
        <end value="32400"/>
        <step-length value="0.1"/>
    </time>
    <processing>
        <ignore-route-errors value="true"/>
        <time-to-teleport value="30"/>
    </processing>
    <output>
        <summary-output value="simulation_summary.xml"/>
        <tripinfo-output value="tripinfo.xml"/>
        <fcd-output value="fcd.xml" samplingRate="1"/>
    </output>
    <gui_only>
        <start value="t"/>
        <quit-on-end value="true"/>
    </gui_only>
    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
        <log value="simulation.log"/>
	<timedEvent type="SaveTLSSwitchStates" dest="signal_result.xml"/>
    </report>
</configuration>
