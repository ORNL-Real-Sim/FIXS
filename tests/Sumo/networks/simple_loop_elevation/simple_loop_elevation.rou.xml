<?xml version="1.0" encoding="UTF-8"?>

<!-- Background demand for the ELEVATED SimpleLoop (FIXS #174).

     Same as the flat networks/simple_loop scenario, but on the rolling-hill net.
     The net (simple_loop_elevation.net.xml) is generated by netconvert FROM
     tests/Vissim/SimpleEcho/simple_loop_elevation.xodr, so SUMO and the Carla/CM
     xodr share ONE 3D geometry (3 up-and-down hills, +-3 m, ~7% peak grade,
     closed so start elevation == end elevation).

     EGO-FREE (like the flat scenario): the ego is supplied per-backend. netconvert
     names the four straights -1..-4 (junction corners are internal), so the loop
     route is "-1 -2 -3 -4". -->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <vType id="car" vClass="passenger" length="5.0" minGap="2.5" maxSpeed="20.0" accel="2.6" decel="4.5" sigma="0.5" color="1,1,0"/>

    <route id="loop" edges="-1 -2 -3 -4" repeat="1000"/>

    <flow id="bg" type="car" route="loop" begin="0" number="40" vehsPerHour="700" departLane="best" departSpeed="max"/>

</routes>
