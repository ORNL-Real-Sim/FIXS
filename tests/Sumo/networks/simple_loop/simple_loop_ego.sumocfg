<?xml version="1.0" encoding="UTF-8"?>

<!-- SUMO config: shared SimpleLoop net + BACKGROUND demand + EGO overlay.
     Used by SUMO-Carla and SimpleEchoClient, whose ego is SUMO-driven and must
     exist in the network. The background file is listed FIRST so its vType/route
     are registered before the overlay (the overlay is self-contained anyway). -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="simple_loop.net.xml"/>
        <route-files value="simple_loop.rou.xml,simple_loop.ego.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>

</configuration>
