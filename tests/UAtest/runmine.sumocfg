<?xml version="1.0" encoding="UTF-8"?>

<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/duarouterConfiguration.xsd">

    <input>
        <net-file value="simulation/network/net.net.xml"/>
        <route-files value="simulation/routes/7_24_23.deterministic.rou.xml"/>
		<additional-files value="simulation/additional/detectors/e2.detectors.add.xml,simulation/additional/detectors/radar.e2.add.xml,simulation/additional/signals/63082002.NEMA.Coordinated.xml,simulation/additional/signals/63082004.NEMA.Coordinated.xml,simulation/additional/veh_distributions/vehDist.xml"/>
    </input>
    <random>
	<seed value="42"/>
    </random>	
	
    <time>
        <begin value="10000"/>
        <end value="20000"/>
        <step-length value="0.1"/>
    </time>
    <gui_only>
	    <start value="f"/>
        <quit-on-end value="true"/>
    </gui_only>
	
    <report>
        <no-warnings value="false"/>
        <no-step-log value="false"/>
    </report>

</configuration>
