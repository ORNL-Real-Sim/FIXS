# =============================================================================
# FIXS Carla automation -- per-machine settings.
# Copy this file to `carla.env` (gitignored) and edit for your box.
# The launch scripts in this folder read it; nothing here is scenario-specific.
# =============================================================================

# Unreal Engine root (must contain Engine\Binaries\Win64\UE4Editor.exe).
# Often set system-wide already; the scripts fall back to %UE4_ROOT% if unset here.
UE4_ROOT=C:\Program Files\Epic Games\UE_4.26

# CARLA source build .uproject (you have the source build here).
CARLA_UPROJECT=C:\src_git\Carla_0915\Unreal\CarlaUE4\CarlaUE4.uproject

# Map the editor launches in -game mode. For OpenDRIVE-standalone scenarios
# (e.g. SimpleLoop) the launched map is irrelevant -- load_opendrive_world.py
# replaces the world from an .xodr after connect -- so any shipped town works.
DEFAULT_MAP=/Game/Carla/Maps/Town01

# CARLA RPC endpoint the bridge + tools connect to.
CARLA_HOST=127.0.0.1
CARLA_PORT=2000

# Python with carla 0.9.15 (+ for the standalone loader: just carla).
# Resolve the executable directly; do not rely on `conda activate`.
PY=C:\Users\%USERNAME%\miniconda3\envs\realsim_dev\python.exe
